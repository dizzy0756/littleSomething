# Root environment reference (documentation only — no secrets)
#
# Each deployable app reads its own .env (see apps/api/.env.example and
# apps/web/.env.example). In production these values live in the platform
# dashboards, not in files:
#   - Render (apps/api):        Render dashboard → Environment
#   - Cloudflare Pages (web):   Pages dashboard → Settings → Environment variables

# --- Backend (Render) ---
DATABASE_URL=postgresql://user:pass@host:5432/little_something
JWT_SECRET=generate-a-long-random-string
ALLOWED_ORIGINS=https://littlesomething.app,https://little-something-builder.pages.dev
RAZORPAY_KEY_ID=rzp_test_xxx
RAZORPAY_KEY_SECRET=xxx
RAZORPAY_WEBHOOK_SECRET=xxx
PAYMENT_AMOUNT=9900
PAYMENT_CURRENCY=INR
PRIVATE_LINK_EXPIRY_DAYS=7
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=https://cdn.littlesomething.app
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=

# --- Frontend (Cloudflare Pages, PUBLIC build-time vars) ---
VITE_API_BASE_URL=https://api.littlesomething.app
VITE_RAZORPAY_KEY_ID=rzp_test_xxx
VITE_CDN_BASE_URL=https://cdn.littlesomething.app
