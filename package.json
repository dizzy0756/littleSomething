{
  "name": "little-something-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Little Something For You — monorepo: Cloudflare frontend + Render backend + PostgreSQL + Razorpay",
  "workspaces": [
    "apps/api",
    "apps/web",
    "packages/shared"
  ],
  "scripts": {
    "dev:api": "npm run dev -w apps/api",
    "dev:web": "npm run dev -w apps/web",
    "build:web": "npm run build -w apps/web",
    "deploy:web": "npm run deploy -w apps/web",
    "lint": "npm run lint -w apps/api"
  },
  "engines": {
    "node": ">=18"
  }
}
