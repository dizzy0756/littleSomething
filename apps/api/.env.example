# ---- Server ----
PORT=3001
NODE_ENV=development

# ---- Database (Render Postgres / Supabase / Neon) ----
DATABASE_URL=postgresql://postgres:pritam13092001@localhost:5432/little_something

# ---- Auth ----
# NEVER commit a real secret. Generate one per environment:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=__CHANGE_ME_GENERATE_A_STRONG_RANDOM_SECRET__
ADMIN_EMAIL=admin@example.com
# Generate a strong admin password:
#   node -e "console.log(require('crypto').randomBytes(18).toString('base64').replace(/[^a-zA-Z0-9]/g,''))"
ADMIN_PASSWORD=__CHANGE_ME_STRONG_ADMIN_PASSWORD__
ADMIN_NAME=Admin

# ---- Public web origin (used to build /s/ links + rewrite stock /assets URLs) ----
# The Cloudflare Pages origin that proxies /s/*, /api/*, /uploads/*, /templates/*
# to this API. Must NOT end with a slash.
WEB_BASE_URL=https://littlesomething.app

# ---- CORS (comma-separated list of frontend origins) ----
# Cloudflare production + any preview deployments + local dev.
ALLOWED_ORIGINS=https://littlesomething.app,https://little-something-builder.pages.dev,http://localhost:5173,http://localhost:3001

# ---- Razorpay (start in TEST mode; swap to LIVE keys post-deployment) ----
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
PAYMENT_AMOUNT=9900
PAYMENT_CURRENCY=INR
PRIVATE_LINK_EXPIRY_DAYS=7

# ---- Cloudflare R2 (object storage for media) ----
# Leave blank to fall back to local /uploads (dev only — Render disk is ephemeral).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=https://cdn.littlesomething.app

# ---- Email (Nodemailer SMTP) ----
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
