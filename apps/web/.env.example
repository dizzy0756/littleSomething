# Public, build-time variables injected by Vite/Cloudflare.
# Copy to `.env` for local dev. NEVER put secrets here — use the Cloudflare
# Pages dashboard for production. These values are shipped to the browser.

# API hosted on Render
VITE_API_BASE_URL=https://api.littlesomething.app

# Razorpay publishable key (safe to expose in the browser)
VITE_RAZORPAY_KEY_ID=

# Cloudflare R2 public CDN base for media delivery
VITE_CDN_BASE_URL=https://cdn.littlesomething.app

# Local dev only: where the Render API runs (used by vite proxy)
VITE_PROXY_API=http://localhost:3001
